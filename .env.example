# ========================================================
# DATABASE CONFIGURATION (Supports MySQL, Supabase/PostgreSQL, or SQLite)
# ========================================================

# Option A: MySQL (Default / Local / RDS / PlanetScale)
# Switch command: npm run db:use:mysql
DATABASE_URL="mysql://root:password@localhost:3306/optimus_drp"

# Option B: Supabase (PostgreSQL with Transaction Pooler)
# Switch command: npm run db:use:supabase
# DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Option C: Local SQLite (Zero-config instant run)
# Switch command: npm run db:use:sqlite
# DATABASE_URL="file:./dev.db"

# ========================================================
# AUTHENTICATION & SECURITY
# ========================================================
JWT_SECRET="drp-platform-hackathon-secure-jwt-secret-key-32chars"

# ========================================================
# OPTIONAL EXTERNAL THREAT INTEL APIS
# ========================================================
GOOGLE_SAFE_BROWSING_API_KEY=""
VIRUSTOTAL_API_KEY=""
URLSCAN_API_KEY=""

# ========================================================
# AI EXPLANATION ENGINE
# ========================================================
AI_API_KEY=""
AI_PROVIDER="local-rules"

# ========================================================
# APPLICATION BRANDING
# ========================================================
NEXT_PUBLIC_APP_NAME="Optimus DRP Platform"
NEXT_PUBLIC_APP_TAGLINE="Liquid Cyberprotection & Threat Intelligence Matrix"
