# ==============================================================================
# OPTIMUS DRP PLATFORM - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# For local development: Copy to .env.local and populate your values.
# For Vercel deployment: Add these key-value pairs in Vercel Project Settings -> Environment Variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Supabase PostgreSQL / Connection Pooler)
# ------------------------------------------------------------------------------
# Production connection to Supabase via Session/Transaction Pooler (Port 6543)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10&pool_timeout=20&sslmode=require"

# Direct connection to Supabase (Port 5432) - Required for Prisma migrations and schema push
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:5432/postgres?sslmode=require"

# ------------------------------------------------------------------------------
# 2. APPLICATION AUTHENTICATION & SESSION
# ------------------------------------------------------------------------------
# Strong 32+ character random secret used by jose to sign drp_session cookies
JWT_SECRET="generate-a-secure-random-32-character-secret-key-here"

# Canonical production URL (used for OAuth redirects and verification links)
NEXT_PUBLIC_APP_URL="https://your-deployment.vercel.app"

# ------------------------------------------------------------------------------
# 3. SUPABASE CONFIGURATION (@supabase/ssr & @supabase/server)
# ------------------------------------------------------------------------------
# Browser-safe Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"

# Browser-safe Public Publishable Key (or standard Anon Key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."

# Server-Side Only Supabase Configuration (NEVER expose to browser with NEXT_PUBLIC_)
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SECRET_KEY="sb_secret_..."
SUPABASE_JWKS_URL="https://[YOUR-PROJECT-REF].supabase.co/auth/v1/.well-known/jwks.json"

# ------------------------------------------------------------------------------
# 4. AI THREAT EXPLANATION & BILY ASSISTANT (Optional - Server Side)
# ------------------------------------------------------------------------------
# Google Gemini API key or external LLM key
AI_API_KEY=""
GEMINI_API_KEY=""
AI_PROVIDER="local-rules"

# ------------------------------------------------------------------------------
# 5. EXTERNAL THREAT INTELLIGENCE APIS (Optional - Server Side)
# ------------------------------------------------------------------------------
GOOGLE_SAFE_BROWSING_API_KEY=""
VIRUSTOTAL_API_KEY=""
URLSCAN_API_KEY=""

# ------------------------------------------------------------------------------
# 6. ENTERPRISE OAUTH PROVIDERS (Optional - Server Side)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"

# ------------------------------------------------------------------------------
# 7. TRANSACTIONAL EMAIL / SMTP (Optional - Server Side)
# ------------------------------------------------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""

# ------------------------------------------------------------------------------
# 8. APPLICATION BRANDING (Public Client)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Optimus DRP Platform"
NEXT_PUBLIC_APP_TAGLINE="Enterprise Digital Risk Protection & Threat Intelligence"
